		"@robojs/server": "workspace:*",
		"discord.js": "^14.25.1",
		"robo.js": "workspace:*",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@swc/core": "^1.15.4",
		"@types/jest": "^29.5.14",
		"@types/node": "^25.0.2",
		"jest": "^29.7.0",
		"prettier": "^3.7.4",
		"ts-jest": "^29.2.5",
		"typescript": "^5.9.3",
		"vite": "^7.2.7"
	}
