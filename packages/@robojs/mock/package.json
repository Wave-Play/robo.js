{
	"name": "@robojs/mock",
	"description": "Discord Gateway mock server for automated testing of Discord.js bots",
	"version": "0.1.0",
	"type": "module",
	"main": ".robo/build/index.js",
	"types": ".robo/build/index.d.ts",
	"files": [
		".robo/",
		"public/",
		"src/",
		"LICENSE",
		"README.md"
	],
	"exports": {
		".": {
			"import": "./.robo/build/index.js",
			"types": "./.robo/build/index.d.ts"
		},
		"./session": {
			"import": "./.robo/build/session/index.js",
			"types": "./.robo/build/session/index.d.ts"
		},
		"./testing": {
			"import": "./.robo/build/testing/index.js",
			"types": "./.robo/build/testing/index.d.ts"
		},
		"./testing/jest-reporter": {
			"types": "./.robo/build/testing/jest-reporter.d.ts",
			"require": "./src/testing/jest-reporter.cjs",
			"import": "./.robo/build/testing/jest-reporter.js",
			"default": "./src/testing/jest-reporter.cjs"
		},
		"./types": {
			"import": "./.robo/build/types/index.js",
			"types": "./.robo/build/types/index.d.ts"
		}
	},
	"keywords": [
		"discord",
		"mock",
		"testing",
		"gateway",
		"websocket",
		"robo",
		"robo.js",
		"typescript"
	],
	"scripts": {
		"build": "npm run build:stage && robo build plugin",
		"build:stage": "vite build --config config/vite.stage.mjs",
		"deploy": "robo deploy",
		"dev": "robo build plugin --watch",
		"dev:stage": "vite build --config config/vite.stage.mjs --watch",
		"doctor": "sage doctor",
		"invite": "robo invite",
		"lint:style": "prettier --write .",
		"start": "robo start",
		"test": "NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest",
		"test:unit": "NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest --selectProjects unit",
		"test:integration": "NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest --selectProjects integration --runInBand --forceExit",
		"tunnel": ".robo/bin/cloudflared tunnel --url http://localhost:3000",
		"upgrade": "sage upgrade"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@robojs/server": "workspace:*",
		"discord-api-types": "^0.37.115",
		"robo.js": "workspace:*",
		"ws": "^8.18.0",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@discordjs/voice": "^0.16.0",
		"@swc/core": "^1.15.3",
		"@tanstack/react-virtual": "^3.10.8",
		"@types/node": "^24.10.1",
		"@types/react": "^18.3.18",
		"@types/react-dom": "^18.3.5",
		"@types/ws": "^8.18.1",
		"@vitejs/plugin-react-swc": "^3.7.2",
		"discord.js": "^14.25.1",
		"prettier": "^3.7.4",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"selfsigned": "^5.2.0",
		"typescript": "^5.9.3",
		"vite": "5"
	}
}
