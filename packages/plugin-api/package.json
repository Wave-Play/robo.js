{
	"name": "@robojs/server",
	"description": "Turn your Robo into a web server! Create and manage web pages, APIs, and more.",
	"version": "0.6.6",
	"private": false,
	"type": "module",
	"main": ".robo/build/index.js",
	"exports": {
		".": {
			"import": "./.robo/build/index.js",
			"types": "./src/index.ts"
		},
		"./client": {
			"import": "./.robo/build/client/dev-reload.js",
			"types": "./src/client/dev-reload.ts"
		},
		"./engines": {
			"import": "./engines.js",
			"types": "./engines.d.ts"
		},
		"./testing": {
			"import": "./testing.js",
			"types": "./testing.d.ts"
		}
	},
	"license": "MIT",
	"author": "WavePlay <dev@waveplay.com> (waveplay.com)",
	"contributors": [
		"Pkmmte Xeleon <pk@waveplay.com>"
	],
	"files": [
		".robo/",
		"seed/",
		"src/",
		"engines.d.ts",
		"engines.js",
		"testing.d.ts",
		"testing.js",
		"LICENSE",
		"README.md"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/Wave-Play/robo.git",
		"directory": "packages/plugin-api"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "robo build plugin",
		"dev": "robo build plugin --watch",
		"lint": "pnpm lint:eslint && pnpm lint:style",
		"lint:eslint": "eslint . --ext js,jsx,ts,tsx",
		"lint:style": "prettier --write .",
		"test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
		"test:types": "tsc -p __typetests__/tsconfig.json"
	},
	"dependencies": {
		"ws": "^8.18.0",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@jest/globals": "^29.7.0",
		"@swc/core": "^1.11.29",
		"@types/jest": "^29.5.12",
		"@types/node": "^20.16.5",
		"@types/ws": "^8.18.1",
		"@typescript-eslint/eslint-plugin": "^5.56.0",
		"@typescript-eslint/parser": "^5.56.0",
		"discord.js": "14.22.1",
		"eslint": "^8.36.0",
		"jest": "^29.7.0",
		"prettier": "^2.8.5",
		"robo.js": "workspace:*",
		"ts-jest": "^29.1.2",
		"typescript": "^5.0.0",
		"vite": "^5.2.0"
	},
	"peerDependencies": {
		"fastify": "^4.15.0",
		"robo.js": ">=0.10.0",
		"vite": "^5.2.0"
	},
	"peerDependenciesMeta": {
		"fastify": {
			"optional": true
		},
		"vite": {
			"optional": true
		}
	}
}
